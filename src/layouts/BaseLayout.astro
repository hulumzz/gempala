---
import '../styles/global.css';
const {
  title = 'Gempala — Youth Organization',
  description = 'Gempala adalah organisasi kepemudaan Bojongireng. Ruang tumbuh, karya, sosial, dan kebersamaan sejak 2021.'
} = Astro.props;
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f3efdf" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700;800;900&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header shell">
      <a class="brand" href="/" aria-label="Gempala home"><span class="brand-dot"></span>GEMPALA<sup>®</sup></a>
      <nav class="desktop-nav" aria-label="Navigasi utama">
        <a class:list={[{active: path.startsWith('/organization')}, 'nav-link']} href="/organization">Crew</a>
        <a class:list={[{active: path.startsWith('/activities')}, 'nav-link']} href="/activities">Activities</a>
        <a class:list={[{active: path.startsWith('/members') || path.startsWith('/m/')}, 'nav-link']} href="/members">Members</a>
        <a class:list={[{active: path.startsWith('/news')}, 'nav-link']} href="/news">Stories</a>
      </nav>
      <button class="menu-button brutal-button small" type="button" aria-expanded="false" aria-controls="mobile-menu">MENU +</button>
    </header>

    <div class="mobile-menu" id="mobile-menu" hidden>
      <div class="mobile-menu-inner shell">
        <div class="eyebrow">GEMPALA / NAV</div>
        <a href="/">Home <span>01</span></a>
        <a href="/organization">The Crew <span>02</span></a>
        <a href="/activities">Activities <span>03</span></a>
        <a href="/achievements">Achievements <span>04</span></a>
        <a href="/members">Members <span>05</span></a>
        <a href="/news">Stories <span>06</span></a>
      </div>
    </div>

    <main><slot /></main>

    <footer class="site-footer">
      <div class="shell footer-top">
        <p class="eyebrow inverse">YOUTH ORGANIZATION / BOJONGIRENG</p>
        <div class="footer-links"><a href="/members">Members ↗</a><a href="/news">Stories ↗</a><a href="https://instagram.com/gempala__" rel="noreferrer" target="_blank">Instagram ↗</a></div>
      </div>
      <div class="footer-word">GEMPALA</div>
      <div class="shell footer-bottom"><span>EST. 2021</span><span>BUILT BY YOUNG PEOPLE, FOR OUR COMMUNITY.</span><span>© 2026</span></div>
    </footer>

    <script is:inline>
      const btn = document.querySelector('.menu-button');
      const menu = document.querySelector('#mobile-menu');
      btn?.addEventListener('click', () => {
        const open = btn.getAttribute('aria-expanded') === 'true';
        btn.setAttribute('aria-expanded', String(!open));
        btn.textContent = open ? 'MENU +' : 'CLOSE ×';
        if (menu) menu.hidden = open;
        document.body.classList.toggle('menu-open', !open);
      });
    </script>
  </body>
</html>
