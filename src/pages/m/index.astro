---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MemberFilterDefs from '../../components/MemberFilterDefs.astro';
import { members, getMemberPhotoUrl, hasBlackBackgroundMemberPhoto } from '../../data/site';
const fallback = JSON.stringify(
  members
    .filter((member) => member.code)
    .map((member) => ({
      ...member,
      photoUrl: getMemberPhotoUrl(member),
      blackKey: hasBlackBackgroundMemberPhoto(member)
    }))
);
---
<BaseLayout title="Member Identity — Gempala" description="Verifikasi identitas member Gempala.">
  <MemberFilterDefs />
  <section class="member-page">
    <div class="shell member-shell">
      <a class="back" href="/members">← MEMBER DIRECTORY</a>

      <div id="checking" class="checking">
        <div class="scan-logo">G</div>
        <p class="eyebrow">CHECKING MEMBER IDENTITY</p>
        <div class="scanbar"><i></i></div>
      </div>

      <div id="profile" class="profile" hidden>
        <div class="identity-card card">
          <div class="identity-head"><span class="brand-mini">GEMPALA®</span><span class="label lime">MEMBER IDENTITY</span></div>
          <div id="portrait-panel" class="portrait-panel tone-purple">
            <span id="portrait-number" class="portrait-number" aria-hidden="true"></span>
            <span class="portrait-orbit orbit-a" aria-hidden="true"></span>
            <span class="portrait-orbit orbit-b" aria-hidden="true"></span>
            <div class="portrait-grid" aria-hidden="true"></div>
            <img id="member-photo" src="/placeholder-member.svg" alt="Foto member Gempala" width="1050" height="1400" />
            <div class="photo-label">OFFICIAL PORTRAIT / GEMPALA®</div>
          </div>
          <div class="identity-data">
            <div class="identity-code"><span class="eyebrow" id="member-code"></span><span class="identity-dot" aria-hidden="true"></span></div>
            <h1 id="member-name">—</h1>
            <p id="member-role"></p>
            <div class="status-line"><span>STATUS</span><strong id="member-status">● ACTIVE MEMBER</strong></div>
          </div>
        </div>

        <div class="profile-info">
          <div class="verified"><span>✓</span><div><b>VERIFIED MEMBER</b><small>GEMPALA ORGANIZATION</small></div></div>
          <div class="profile-kicker eyebrow">DIGITAL MEMBER PROFILE / 2026</div>
          <h2 id="member-nickname">—</h2>
          <p id="member-bio"></p>
          <dl>
            <div><dt>JOINED</dt><dd id="member-joined"></dd></div>
            <div><dt>DIVISION</dt><dd id="member-division"></dd></div>
            <div><dt>MEMBER ID</dt><dd id="member-id-repeat"></dd></div>
          </dl>
          <a class="brutal-button" href="/">View Gempala ↗</a>
        </div>
      </div>

      <div id="not-found" class="not-found card" hidden>
        <span>404 / MEMBER</span>
        <h1 class="display md">MEMBER<br/>NOT FOUND.</h1>
        <p id="missing-code"></p>
        <a class="brutal-button" href="/members">Open directory ↗</a>
      </div>
    </div>
  </section>

  <script define:vars={{ fallback }} is:inline>
    const mocks = JSON.parse(fallback);
    const code = decodeURIComponent(location.pathname.split('/').filter(Boolean).pop() || '').toUpperCase();
    const checking = document.querySelector('#checking');
    const profile = document.querySelector('#profile');
    const notFound = document.querySelector('#not-found');
    const photo = document.querySelector('#member-photo');
    const portraitPanel = document.querySelector('#portrait-panel');
    const placeholder = '/placeholder-member.svg';
    const tones = ['purple', 'sky', 'lime', 'orange', 'pink', 'cream'];

    const set = (id, value) => {
      const el = document.querySelector(id);
      if (el) el.textContent = value || '—';
    };

    const resolvePhoto = (member) => {
      if (member?.photoUrl) return member.photoUrl;
      if (!member?.photo) return placeholder;
      if (/^https?:\/\//i.test(member.photo) || member.photo.startsWith('/')) return member.photo;
      return `/members/${member.photo}`;
    };

    const toneForMember = (member) => {
      const suffix = Number(String(member?.code || '').split('-').pop());
      if (Number.isFinite(suffix) && suffix > 0) return tones[(suffix - 1) % tones.length];
      return tones[0];
    };

    function render(member) {
      set('#member-code', member.code);
      set('#member-name', member.name);
      set('#member-role', [member.role, member.division].filter(Boolean).join(' / '));
      set('#member-status', `● ${member.status || 'ACTIVE'} MEMBER`);
      set('#member-nickname', member.nickname || member.name);
      set('#member-bio', member.bio);
      set('#member-joined', member.joined);
      set('#member-division', member.division);
      set('#member-id-repeat', member.code);
      set('#portrait-number', String(member.code || '').split('-').pop());

      if (portraitPanel) {
        tones.forEach((tone) => portraitPanel.classList.remove(`tone-${tone}`));
        portraitPanel.classList.add(`tone-${toneForMember(member)}`);
      }

      if (photo) {
        photo.src = resolvePhoto(member);
        photo.alt = member.name ? `Foto ${member.name}` : 'Foto member Gempala';
        photo.classList.toggle('black-key', Boolean(member.blackKey));
        photo.onerror = () => {
          photo.onerror = null;
          photo.src = placeholder;
          photo.classList.remove('black-key');
          portraitPanel?.classList.add('no-photo');
        };
      }

      checking.hidden = true;
      profile.hidden = false;
    }

    function missing() {
      checking.hidden = true;
      notFound.hidden = false;
      set('#missing-code', `${code || 'UNKNOWN'} is not registered in the Gempala member directory.`);
    }

    async function load() {
      await new Promise((resolve) => setTimeout(resolve, 280));

      // Current printed QR cards use the local dataset as the authoritative ID list.
      const local = mocks.find((member) => member.code === code);
      if (local) return render(local);

      // Neon remains a fallback for future members that may be added dynamically.
      try {
        const response = await fetch(`/api/members/${encodeURIComponent(code)}`);
        if (response.ok) {
          const json = await response.json();
          if (json?.member) return render(json.member);
        }
      } catch {}

      missing();
    }

    load();
  </script>

  <style>
    .member-page{min-height:calc(100vh - 92px);background:var(--ink);color:var(--paper);padding:38px 0 90px}.back{font:800 10px Archivo;letter-spacing:.08em}.member-shell{position:relative}.checking{min-height:70vh;display:grid;place-items:center;align-content:center;gap:18px}.scan-logo{width:100px;height:100px;background:var(--purple);color:var(--ink);border:3px solid var(--paper);display:grid;place-items:center;font:900 55px Archivo;transform:rotate(-4deg)}.scanbar{width:min(320px,80vw);height:10px;border:2px solid var(--paper);overflow:hidden}.scanbar i{display:block;height:100%;width:35%;background:var(--lime);animation:scan .7s ease-in-out infinite alternate}@keyframes scan{to{transform:translateX(190%)}}
    .profile{display:grid;grid-template-columns:minmax(0,520px) minmax(0,1fr);gap:clamp(42px,7vw,90px);align-items:center;padding-top:45px}.identity-card{background:var(--paper);color:var(--ink);box-shadow:10px 10px 0 var(--purple);overflow:hidden}.identity-head{display:flex;justify-content:space-between;align-items:center;padding:18px;border-bottom:var(--line);gap:12px}.brand-mini{font:900 18px Archivo}
    .portrait-panel{aspect-ratio:3/4;border-bottom:var(--line);position:relative;overflow:hidden;isolation:isolate;background:var(--purple)}.tone-purple{background:var(--purple)}.tone-sky{background:var(--blue)}.tone-lime{background:var(--lime)}.tone-orange{background:var(--orange)}.tone-pink{background:var(--pink)}.tone-cream{background:var(--paper)}
    .portrait-panel img{display:block;width:92%;height:92%;object-fit:contain;object-position:center bottom;position:absolute;z-index:3;left:4%;bottom:0}.portrait-panel.no-photo img{width:65%;height:65%;left:17.5%;bottom:15%;opacity:.75}.portrait-grid{position:absolute;inset:0;z-index:1;opacity:.12;background-image:linear-gradient(var(--ink) 1px,transparent 1px),linear-gradient(90deg,var(--ink) 1px,transparent 1px);background-size:34px 34px}.portrait-number{position:absolute;z-index:1;right:-10px;top:45px;font:900 clamp(130px,19vw,220px)/.72 Archivo;letter-spacing:-.1em;color:rgba(20,20,20,.13)}.portrait-orbit{position:absolute;z-index:1;border:2px solid var(--ink);border-radius:50%;opacity:.5}.orbit-a{width:56%;aspect-ratio:1;left:-19%;bottom:9%}.orbit-b{width:30%;aspect-ratio:1;right:-9%;top:31%;background:rgba(255,255,255,.18)}.photo-label{position:absolute;z-index:4;bottom:18px;left:18px;background:var(--lime);border:var(--line);padding:8px;font:900 8px Archivo;letter-spacing:.06em;transform:rotate(-3deg);box-shadow:3px 3px var(--ink)}
    .identity-data{padding:24px}.identity-code{display:flex;justify-content:space-between;align-items:center;gap:16px}.identity-dot{width:13px;height:13px;border:2px solid var(--ink);background:var(--lime);border-radius:50%}.identity-data h1{font:900 clamp(34px,5vw,60px)/.95 Archivo;letter-spacing:-.055em;margin:14px 0;overflow-wrap:anywhere;text-transform:uppercase}.identity-data>p{font-size:12px;font-weight:700}.status-line{display:flex;justify-content:space-between;border-top:var(--line);margin-top:26px;padding-top:16px;font:800 10px Archivo;gap:20px}.status-line strong{color:#2a7600}
    .verified{display:inline-flex;align-items:center;gap:14px;background:var(--lime);color:var(--ink);border:var(--line);box-shadow:4px 4px var(--purple);padding:13px 17px;transform:rotate(-2deg)}.verified>span{font:900 28px Archivo}.verified b,.verified small{display:block;font-family:Archivo}.verified b{font-size:12px}.verified small{font-size:8px;margin-top:3px}.profile-kicker{margin-top:40px;color:#aaa69c}.profile-info h2{font:900 clamp(52px,8vw,105px)/.9 Archivo;letter-spacing:-.065em;margin:18px 0 20px;overflow-wrap:anywhere;text-transform:uppercase}.profile-info>p{font-size:15px;line-height:1.75;max-width:520px;color:#d8d3c6}.profile-info dl{border-block:2px solid var(--paper);margin:30px 0}.profile-info dl div{display:grid;grid-template-columns:130px 1fr;padding:13px 0;border-bottom:1px solid #595959}.profile-info dl div:last-child{border:0}.profile-info dt{font:800 9px Archivo}.profile-info dd{margin:0;font:700 11px Archivo}.not-found{color:var(--ink);max-width:780px;margin:70px auto;padding:50px}.not-found>span{font:800 10px Archivo}.not-found p{margin:25px 0 35px}
    @media(max-width:800px){.member-page{min-height:100vh}.profile{grid-template-columns:1fr;gap:45px}.identity-card{max-width:520px;width:100%;margin-inline:auto}.profile-info h2{margin-top:16px}.not-found{padding:30px}}
    @media(max-width:520px){.identity-head{padding:13px}.brand-mini{font-size:15px}.portrait-panel img{width:94%;left:3%}.identity-data{padding:19px}.status-line{align-items:flex-start;flex-direction:column;gap:8px}.profile-info dl div{grid-template-columns:100px 1fr}}
  </style>
</BaseLayout>
