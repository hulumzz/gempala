---
import BaseLayout from '../layouts/BaseLayout.astro';
import { members, getMemberPhotoUrl, getMemberTone, hasUploadedMemberPhoto } from '../data/site';
---
<BaseLayout title="Members — Gempala">
  <section class="page-hero shell">
    <div class="section-kicker eyebrow">MEMBER DIRECTORY / VERIFIED</div>
    <h1 class="display xl">THE<br/>PEOPLE.</h1>
    <p class="lead">Cari nama, nickname, atau Member ID. Profil dengan identitas resmi dapat dibuka langsung melalui QR member card Gempala.</p>
  </section>

  <section class="section directory">
    <div class="shell">
      <div class="directory-toolbar">
        <div class="search-wrap">
          <label class="sr-only" for="member-search">Cari nama, nickname, ID, atau peran member</label>
          <input id="member-search" class="input-brutal" type="search" placeholder="Cari nama, peran, atau Member ID…" aria-controls="member-grid" autocomplete="off" />
          <span aria-hidden="true">⌕</span>
        </div>
        <div class="directory-note eyebrow" aria-live="polite" aria-atomic="true">{members.length} PROFIL / GEMPALA</div>
      </div>

      <div class="member-grid" id="member-grid">
        {members.map((m, index) => {
          const identified = Boolean(m.code && m.name);
          const photoUrl = getMemberPhotoUrl(m);
          const hasPhoto = hasUploadedMemberPhoto(m);

          const searchValue = `${m.name} ${m.nickname} ${m.code} ${m.role} ${m.division}`.toLowerCase();
          const tone = getMemberTone(index);
          const number = String(index + 1).padStart(2, '0');

          return identified ? (
            <a class="member-card card" href={`/m/${m.code}`} data-search={searchValue}>
              <div class:list={['member-visual', `tone-${tone}`, !hasPhoto && 'no-photo']}>
                <div class="visual-top"><span>MEMBER / {number}</span><i aria-hidden="true"></i></div>
                <span class="visual-number" aria-hidden="true">{number}</span>
                <span class="shape shape-a" aria-hidden="true"></span>
                <span class="shape shape-b" aria-hidden="true"></span>
                <img src={photoUrl} alt={hasPhoto ? `Foto ${m.name}` : `Foto ${m.name} belum tersedia`} loading="lazy" width="1050" height="1400" />
                <b class="portrait-label">{hasPhoto ? 'GEMPALA® PORTRAIT' : 'PHOTO PENDING'}</b>
              </div>
              <div class="member-info">
                <div class="member-meta"><span class="eyebrow">{m.code}</span><span class:list={['status', m.status === 'ACTIVE' && 'active']}>● {m.status}</span></div>
                <h2>{m.name}</h2>
                {m.quote && <p class="directory-quote"><strong>Quote:</strong> {m.quote}</p>}
                <div class="member-foot"><p>{m.role} / {m.division}</p><span class="open">VIEW ID ↗</span></div>
              </div>
            </a>
          ) : (
            <article class="member-card card pending-card" data-search={searchValue || 'profile data pending'}>
              <div class:list={['member-visual', `tone-${tone}`]}>
                <div class="visual-top"><span>MEMBER / {number}</span><i aria-hidden="true"></i></div>
                <span class="visual-number" aria-hidden="true">{number}</span>
                <span class="shape shape-a" aria-hidden="true"></span>
                <span class="shape shape-b" aria-hidden="true"></span>
                <img src={photoUrl} alt="Foto member Gempala" loading="lazy" width="1050" height="1400" />
                <b class="portrait-label">GEMPALA® PORTRAIT</b>
              </div>
              <div class="member-info pending-info">
                <div class="member-meta"><span class="eyebrow">PROFILE</span><span class="pending-badge">DATA PENDING</span></div>
                <h2 class="pending-title">PROFILE DATA<br/>PENDING</h2>
                <div class="member-foot"><p>Identity has not been published.</p><span class="open muted">NO MEMBER LINK</span></div>
              </div>
            </article>
          );
        })}
      </div>

      <div id="member-empty" class="empty-state" hidden>
        <strong>NO MEMBER FOUND.</strong>
        <p>Coba nama, nickname, atau Member ID yang lain.</p>
        <button id="member-reset" class="brutal-button" type="button">Tampilkan semua member ↗</button>
      </div>
    </div>
  </section>

  <script is:inline>
    const input = document.querySelector('#member-search');
    const cards = [...document.querySelectorAll('.member-card')];
    const empty = document.querySelector('#member-empty');
    const note = document.querySelector('.directory-note');
    function filterMembers() {
      const query = input.value.toLowerCase().trim();
      let shown = 0;
      cards.forEach((card) => {
        const ok = card.dataset.search.includes(query);
        card.hidden = !ok;
        if (ok) shown++;
      });
      if (empty) empty.hidden = shown !== 0;
      if (note) note.textContent = `${shown} PROFIL${query ? ' DITEMUKAN' : ' / GEMPALA'}`;
    }
    input?.addEventListener('input', filterMembers);
    document.querySelector('#member-reset')?.addEventListener('click', () => {
      if (!input) return;
      input.value = '';
      filterMembers();
      input.focus();
    });
  </script>

  <style>
    .directory-quote{margin:0 0 20px;font-size:13px;line-height:1.6;overflow-wrap:anywhere}
    .directory-quote strong{font-family:Archivo}
    .directory {
      background: var(--purple);
      border-top: var(--line);
    }
    .directory-toolbar {
      display: grid;
      grid-template-columns: minmax(0, 760px) 1fr;
      align-items: end;
      gap: 24px;
      margin-bottom: 48px;
    }
    .search-wrap {
      position: relative;
    }
    .search-wrap span {
      position: absolute;
      right: 18px;
      top: 50%;
      transform: translateY(-50%);
      font-size: 28px;
      font-weight: 900;
      pointer-events: none;
    }
    .directory-note {
      text-align: right;
      color: var(--paper);
    }
    .member-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 28px;
      align-items: start;
    }
    .member-card {
      overflow: hidden;
      transition:
        transform 0.16s ease,
        box-shadow 0.16s ease;
      background: var(--paper);
      min-width: 0;
    }
    a.member-card:hover {
      transform: translate(-3px, -5px) rotate(-0.35deg);
      box-shadow: 9px 11px var(--ink);
    }
    .member-visual {
      aspect-ratio: 3/4;
      border-bottom: var(--line);
      position: relative;
      overflow: hidden;
      isolation: isolate;
      background: var(--purple);
    }
    .tone-purple {
      background: var(--purple);
    }
    .tone-sky {
      background: var(--blue);
    }
    .tone-lime {
      background: var(--lime);
    }
    .tone-orange {
      background: var(--orange);
    }
    .tone-pink {
      background: var(--pink);
    }
    .tone-cream {
      background: var(--paper);
    }
    .visual-top {
      position: absolute;
      z-index: 5;
      top: 13px;
      left: 13px;
      right: 13px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      font: 900 9px Archivo;
      letter-spacing: 0.1em;
    }
    .visual-top i {
      width: 12px;
      height: 12px;
      background: var(--ink);
      border-radius: 50%;
      box-shadow: 2px 2px 0 rgba(255, 255, 255, 0.6);
    }
    .visual-number {
      position: absolute;
      z-index: 0;
      right: -8px;
      top: 32px;
      font: 900 clamp(92px, 12vw, 160px)/0.75 Archivo;
      letter-spacing: -0.09em;
      color: rgba(20, 20, 20, 0.12);
      transform: rotate(4deg);
    }
    .shape {
      position: absolute;
      z-index: 0;
      border: 2px solid var(--ink);
      opacity: 0.55;
    }
    .shape-a {
      width: 42%;
      aspect-ratio: 1;
      border-radius: 50%;
      left: -14%;
      bottom: 11%;
    }
    .shape-b {
      width: 38%;
      height: 13%;
      right: -9%;
      top: 31%;
      transform: rotate(-11deg);
      background: rgba(255, 255, 255, 0.23);
    }
    .member-visual img {
      display: block;
      width: 92%;
      height: 91%;
      object-fit: contain;
      object-position: center bottom;
      position: absolute;
      z-index: 2;
      left: 4%;
      bottom: 0;
    }
    .member-visual.no-photo img {
      width: 70%;
      height: 70%;
      left: 15%;
      bottom: 12%;
      opacity: 0.72;
    }
    .portrait-label {
      position: absolute;
      z-index: 6;
      bottom: 14px;
      left: 14px;
      background: var(--paper);
      border: var(--line);
      padding: 7px 9px;
      font: 900 8px Archivo;
      letter-spacing: 0.06em;
      transform: rotate(-2deg);
      box-shadow: 3px 3px var(--ink);
    }
    .member-info {
      padding: 18px 19px 19px;
      min-height: 190px;
      display: flex;
      flex-direction: column;
      background: var(--white);
    }
    .member-meta {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
    }
    .status {
      font: 900 9px Archivo;
      white-space: nowrap;
    }
    .status.active {
      color: #277800;
    }
    .member-info h2 {
      font: 900 clamp(25px, 2.5vw, 34px)/0.94 Archivo;
      margin: 20px 0 22px;
      letter-spacing: -0.045em;
      overflow-wrap: anywhere;
      text-transform: uppercase;
    }
    .member-foot {
      margin-top: auto;
      display: flex;
      justify-content: space-between;
      align-items: end;
      gap: 16px;
      border-top: 2px solid var(--ink);
      padding-top: 12px;
    }
    .member-foot p {
      font: 700 10px/1.4 Archivo;
      margin: 0;
      max-width: 68%;
    }
    .open {
      font: 900 9px Archivo;
      white-space: nowrap;
    }
    .open.muted {
      opacity: 0.55;
    }
    .pending-card {
      cursor: default;
    }
    .pending-info {
      background: var(--paper);
    }
    .pending-badge {
      font: 900 9px Archivo;
      background: var(--lime);
      border: 2px solid var(--ink);
      padding: 5px 7px;
      transform: rotate(1deg);
    }
    .pending-title {
      font-size: 27px !important;
    }
    .empty-state {
      max-width: 650px;
      margin: auto;
    }
    .empty-state strong {
      font: 900 30px Archivo;
    }
    .search-wrap span {
      left: 18px;
      right: auto;
    }
    .search-wrap .input-brutal {
      padding-left: 52px;
      padding-right: 18px;
    }
    .member-meta,
    .member-foot {
      flex-wrap: wrap;
      gap: 10px;
    }
    .member-info h2 {
      line-height: 1.03;
    }
    @media (hover: none) {
      a.member-card:hover {
        transform: none;
        box-shadow: var(--shadow);
      }
    }
    @media (max-width: 900px) {
      .directory-toolbar {
        grid-template-columns: 1fr;
      }
      .directory-note {
        text-align: left;
      }
      .member-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }
    @media (max-width: 560px) {
      .member-grid {
        grid-template-columns: 1fr;
        gap: 22px;
      }
      .member-card {
        max-width: 390px;
        width: 100%;
        margin-inline: auto;
      }
      .member-info {
        min-height: 176px;
      }
      .member-visual img {
        width: 94%;
        left: 3%;
      }
      .visual-number {
        font-size: 130px;
      }
    }
  </style>
</BaseLayout>
