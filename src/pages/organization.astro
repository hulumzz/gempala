---
import BaseLayout from '../layouts/BaseLayout.astro';
import { members, getMemberPhotoUrl } from '../data/site';
const crewMembers = members.filter((member) => member.code && member.name);
---
<BaseLayout title="The Crew — Gempala">
  <section class="page-hero shell"><div class="section-kicker eyebrow">THE ORGANIZATION / 2026</div><h1 class="display xl">MEET<br/>THE CREW.</h1><p class="lead">Orang-orang yang menggerakkan ide, acara, dokumentasi, kerja sosial, dan semua hal kecil yang membuat Gempala tetap hidup.</p></section>
  <div class="ticker"><div class="ticker-track"><span>NO BIG TITLES</span><span>JUST REAL WORK</span><span>MOVE TOGETHER</span><span>NO BIG TITLES</span><span>JUST REAL WORK</span><span>MOVE TOGETHER</span></div></div>

  <section class="section shell">
    <div class="crew-grid">
      {crewMembers.map((member,index)=><a class:list={['crew-card','card',index===0&&'leader']} href={`/m/${member.code}`}>
        <div class:list={['portrait', `tone-${index % 4}`]}>
          <img src={getMemberPhotoUrl(member)} alt={`Foto ${member.name}`} loading={index < 3 ? 'eager' : 'lazy'} width="300" height="400" />
          <span>{String(index+1).padStart(2,'0')} / PORTRAIT</span>
        </div>
        <div class="crew-info"><span class="eyebrow">{member.division}</span><h2>{member.name}</h2><div><span>{member.role}</span><b>↗</b></div></div>
      </a>)}
    </div>
  </section>

  <section class="section values"><div class="shell"><div class="section-kicker eyebrow">HOW WE MOVE</div><div class="value-grid"><article><b>01</b><h3>DEKAT.</h3><p>Berangkat dari lingkungan sendiri dan tetap punya hubungan nyata dengan warga.</p></article><article><b>02</b><h3>GERAK.</h3><p>Ide tidak berhenti di grup chat. Kalau bisa dikerjakan, kita mulai.</p></article><article><b>03</b><h3>BARENG.</h3><p>Gempala tumbuh sebagai kolektif, bukan panggung satu orang.</p></article></div></div></section>

  <style>
    .crew-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:28px;align-items:start}.crew-card{transition:.18s;overflow:hidden}.crew-card:hover{transform:translate(-3px,-5px);box-shadow:9px 11px var(--ink)}.crew-card.leader{grid-column:span 2}
    .portrait{aspect-ratio:3/4;background:var(--blue);border-bottom:var(--line);position:relative;overflow:hidden;isolation:isolate}.leader .portrait{aspect-ratio:4/3;background:var(--purple)}.portrait.tone-1{background:var(--lime)}.portrait.tone-2{background:var(--orange)}.portrait.tone-3{background:var(--paper)}
    .portrait img{display:block;width:100%;height:100%;object-fit:contain;object-position:center bottom;position:relative;z-index:1}.portrait span{position:absolute;left:14px;bottom:14px;z-index:2;background:var(--paper);border:var(--line);box-shadow:3px 3px var(--ink);padding:8px 10px;font:800 10px Archivo;transform:rotate(-3deg)}
    .crew-info{padding:20px}.crew-info h2{font:900 clamp(25px,3vw,42px)/1 Archivo;margin:12px 0;letter-spacing:-.04em;overflow-wrap:anywhere}.crew-info>div{display:flex;justify-content:space-between;font:700 13px Archivo}
    .values{background:var(--orange);border-block:var(--line)}.value-grid{display:grid;grid-template-columns:repeat(3,1fr);margin-top:35px;border:var(--line)}.value-grid article{padding:30px;border-right:var(--line);min-height:280px}.value-grid article:last-child{border:0}.value-grid b{font:900 12px Archivo}.value-grid h3{font:900 52px Archivo;margin:60px 0 15px;letter-spacing:-.06em}.value-grid p{font-size:13px;line-height:1.7}
    @media(max-width:800px){.crew-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.crew-card.leader{grid-column:span 2}.leader .portrait{aspect-ratio:3/2}.value-grid{grid-template-columns:1fr}.value-grid article{border-right:0;border-bottom:var(--line);min-height:220px}.value-grid article:last-child{border-bottom:0}.value-grid h3{margin-top:35px}}
    @media(max-width:520px){.crew-grid{grid-template-columns:1fr}.crew-card.leader{grid-column:auto}.leader .portrait,.portrait{aspect-ratio:3/4}.crew-card{max-width:390px;width:100%;margin-inline:auto}}
  </style>
</BaseLayout>
