---
import BaseLayout from '../layouts/BaseLayout.astro';
import { members, getMemberPhotoUrl, getMemberTone, hasUploadedMemberPhoto } from '../data/site';
const crewMembers = members.filter((member) => member.code && member.name);
---
<BaseLayout title="The Crew — Gempala">
  <section class="page-hero shell"><div class="section-kicker eyebrow">THE ORGANIZATION / 2026</div><h1 class="display xl">MEET<br/>THE CREW.</h1><p class="lead">Orang-orang yang menggerakkan ide, acara, dokumentasi, kerja sosial, dan semua hal kecil yang membuat Gempala tetap hidup.</p></section>
  <div class="ticker"><div class="ticker-track"><span>NO BIG TITLES</span><span>JUST REAL WORK</span><span>MOVE TOGETHER</span><span>NO BIG TITLES</span><span>JUST REAL WORK</span><span>MOVE TOGETHER</span></div></div>

  <section class="section shell">
    <div class="crew-grid">
      {crewMembers.map((member,index) => {
        const tone = getMemberTone(index);
        const hasPhoto = hasUploadedMemberPhoto(member);

        const number = String(index + 1).padStart(2, '0');
        return <a class:list={['crew-card','card',index===0&&'leader']} href={`/m/${member.code}`}>
          <div class:list={['portrait', `tone-${tone}`, !hasPhoto && 'no-photo']}>
            <div class="portrait-top"><span>CREW / {number}</span><i aria-hidden="true"></i></div>
            <span class="portrait-number" aria-hidden="true">{number}</span>
            <span class="portrait-ring" aria-hidden="true"></span>
            <img src={getMemberPhotoUrl(member)} alt={hasPhoto ? `Foto ${member.name}` : `Foto ${member.name} belum tersedia`} loading={index < 3 ? 'eager' : 'lazy'} width="1050" height="1400" />
            <span class="portrait-chip">{hasPhoto ? 'GEMPALA® PORTRAIT' : 'PHOTO PENDING'}</span>
          </div>
          <div class="crew-info">
            <div class="crew-index"><span class="eyebrow">{member.division}</span><span class="eyebrow">{member.code}</span></div>
            <h2>{member.name}</h2>
            <div class="crew-bottom"><span>{member.role}</span><b>OPEN PROFILE ↗</b></div>
          </div>
        </a>
      })}
    </div>
  </section>

  <section class="section values"><div class="shell"><div class="section-kicker eyebrow">HOW WE MOVE</div><div class="value-grid"><article><b>01</b><h3>DEKAT.</h3><p>Berangkat dari lingkungan sendiri dan tetap punya hubungan nyata dengan warga.</p></article><article><b>02</b><h3>GERAK.</h3><p>Ide tidak berhenti di grup chat. Kalau bisa dikerjakan, kita mulai.</p></article><article><b>03</b><h3>BARENG.</h3><p>Gempala tumbuh sebagai kolektif, bukan panggung satu orang.</p></article></div></div></section>

  <style>
    .crew-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 28px;
      align-items: start;
    }
    .crew-card {
      transition: 0.18s;
      overflow: hidden;
      background: var(--white);
    }
    .crew-card:hover {
      transform: translate(-3px, -5px);
      box-shadow: 9px 11px var(--ink);
    }
    .crew-card.leader {
      grid-column: span 2;
      display: grid;
      grid-template-columns: minmax(280px, 0.9fr) minmax(0, 1.1fr);
      align-items: stretch;
    }
    .leader .portrait {
      border-bottom: 0;
      border-right: var(--line);
    }
    .leader .crew-info {
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      padding: clamp(24px, 4vw, 48px);
    }
    .leader .crew-info h2 {
      font-size: clamp(44px, 6vw, 82px);
      margin: auto 0 28px;
    }
    .portrait {
      aspect-ratio: 3/4;
      background: var(--purple);
      border-bottom: var(--line);
      position: relative;
      overflow: hidden;
      isolation: isolate;
    }
    .tone-purple {
      background: var(--purple);
    }
    .tone-sky {
      background: var(--blue);
    }
    .tone-lime {
      background: var(--lime);
    }
    .tone-orange {
      background: var(--orange);
    }
    .tone-pink {
      background: var(--pink);
    }
    .tone-cream {
      background: var(--paper);
    }
    .portrait-top {
      position: absolute;
      z-index: 5;
      top: 13px;
      left: 13px;
      right: 13px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      font: 900 9px Archivo;
      letter-spacing: 0.1em;
    }
    .portrait-top i {
      width: 11px;
      height: 11px;
      background: var(--ink);
      border-radius: 50%;
    }
    .portrait-number {
      position: absolute;
      z-index: 0;
      right: -6px;
      top: 44px;
      font: 900 clamp(90px, 12vw, 155px)/0.75 Archivo;
      color: rgba(20, 20, 20, 0.12);
      letter-spacing: -0.09em;
    }
    .portrait-ring {
      position: absolute;
      z-index: 0;
      width: 55%;
      aspect-ratio: 1;
      border: 2px solid var(--ink);
      border-radius: 50%;
      left: -18%;
      bottom: 8%;
      opacity: 0.45;
    }
    .portrait img {
      display: block;
      width: 92%;
      height: 91%;
      object-fit: contain;
      object-position: center bottom;
      position: absolute;
      z-index: 2;
      left: 4%;
      bottom: 0;
    }
    .portrait.no-photo img {
      width: 68%;
      height: 68%;
      left: 16%;
      bottom: 14%;
      opacity: 0.72;
    }
    .portrait-chip {
      position: absolute;
      z-index: 5;
      left: 14px;
      bottom: 14px;
      background: var(--paper);
      border: var(--line);
      box-shadow: 3px 3px var(--ink);
      padding: 7px 9px;
      font: 900 8px Archivo;
      letter-spacing: 0.06em;
      transform: rotate(-2deg);
    }
    .crew-info {
      padding: 20px;
      min-width: 0;
    }
    .crew-index,
    .crew-bottom {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 14px;
    }
    .crew-index span:last-child {
      text-align: right;
    }
    .crew-info h2 {
      font: 900 clamp(25px, 3vw, 42px)/0.94 Archivo;
      margin: 18px 0 24px;
      letter-spacing: -0.045em;
      overflow-wrap: anywhere;
      text-transform: uppercase;
    }
    .crew-bottom {
      border-top: 2px solid var(--ink);
      padding-top: 12px;
      font: 800 10px Archivo;
    }
    .crew-bottom b {
      font-size: 9px;
      text-align: right;
    }
    .values {
      background: var(--orange);
      border-block: var(--line);
    }
    .value-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      margin-top: 35px;
      border: var(--line);
    }
    .value-grid article {
      padding: 30px;
      border-right: var(--line);
      min-height: 280px;
    }
    .value-grid article:last-child {
      border: 0;
    }
    .value-grid b {
      font: 900 12px Archivo;
    }
    .value-grid h3 {
      font: 900 52px Archivo;
      margin: 60px 0 15px;
      letter-spacing: -0.06em;
    }
    .value-grid p {
      font-size: 13px;
      line-height: 1.7;
    }
    .crew-index,
    .crew-bottom {
      flex-wrap: wrap;
      gap: 10px;
    }
    .crew-info h2 {
      line-height: 1.02;
    }
    .value-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .value-grid h3 {
      font-size: clamp(36px, 4.2vw, 52px);
    }
    @media (hover: none) {
      .crew-card:hover {
        transform: none;
        box-shadow: var(--shadow);
      }
    }
    @media (max-width: 900px) {
      .crew-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
      .crew-card.leader {
        grid-column: span 2;
      }
      .value-grid {
        grid-template-columns: 1fr;
      }
      .value-grid article {
        border-right: 0;
        border-bottom: var(--line);
        min-height: 220px;
      }
      .value-grid article:last-child {
        border-bottom: 0;
      }
      .value-grid h3 {
        margin-top: 35px;
      }
    }
    @media (max-width: 700px) {
      .crew-card.leader {
        grid-template-columns: 1fr;
      }
      .leader .portrait {
        border-right: 0;
        border-bottom: var(--line);
      }
      .leader .crew-info {
        padding: 22px;
      }
      .leader .crew-info h2 {
        font-size: clamp(34px, 11vw, 58px);
        margin: 28px 0;
      }
    }
    @media (max-width: 520px) {
      .crew-grid {
        grid-template-columns: 1fr;
      }
      .crew-card.leader {
        grid-column: auto;
      }
      .crew-card {
        max-width: 390px;
        width: 100%;
        margin-inline: auto;
      }
      .portrait img {
        width: 94%;
        left: 3%;
      }
    }
  </style>
</BaseLayout>
