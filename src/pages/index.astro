---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  activities,
  achievements,
  achievementPhoto,
  members,
  stories,
  getMemberPhotoUrl,
  hasUploadedMemberPhoto,
  getMemberTone
} from '../data/site';
const featuredMembers = members.filter((member) => member.code && member.name && hasUploadedMemberPhoto(member)).slice(0, 3);
---
<BaseLayout title="Gempala — Youth Movement from Bojongireng">
  <section class="hero shell">
    <div class="hero-copy" data-reveal>
      <div class="hero-meta"><span class="label lime">EST. 2021</span><span class="eyebrow">BOJONGIRENG / CENTRAL JAVA</span></div>
      <h1 class="display xl">WE ARE<br/><span>GEMPALA.</span></h1>
      <div class="hero-bottom">
        <p class="lead">Tumbuh bareng. Bergerak bareng. Bikin sesuatu yang berarti.</p>
        <a class="brutal-button" href="/activities">Jelajahi Gempala ↗</a>
      </div>
    </div>
    <div class="hero-collage" aria-label="Dokumentasi kegiatan Gempala">
      <figure class="photo photo-a">
        <img src={achievementPhoto.src} alt={achievementPhoto.alt} width="1536" height="1152" fetchpriority="high" />
        <figcaption>ACHIEVEMENT / CREW</figcaption>
      </figure>
      <figure class="photo photo-b">
        <img src="/activities/hut-ri.jpg" alt="Dokumentasi Semarak HUT RI Gempala" width="864" height="1536" fetchpriority="high" />
        <figcaption>HUT RI / COMMUNITY</figcaption>
      </figure>
      <div class="photo-note">YOUTH / SOCIAL / CREATIVE<br/>BOJONGIRENG '26</div>
      <svg class="hero-spark" viewBox="0 0 100 100" aria-hidden="true"><path d="M50 3 60 32 85 15 68 40 97 50 68 60 85 85 60 68 50 97 40 68 15 85 32 60 3 50 32 40 15 15 40 32Z" /></svg>
    </div>
  </section>

  <div class="ticker"><div class="ticker-track"><span>GEMPALA</span><span>PEMUDA</span><span>KREATIF</span><span>SOSIAL</span><span>SOLID</span><span>BOJONGIRENG</span><span>GEMPALA</span><span>PEMUDA</span><span>KREATIF</span><span>SOSIAL</span><span>SOLID</span><span>BOJONGIRENG</span></div></div>

  <section class="section shell about-grid">
    <div><div class="section-kicker eyebrow">01 / WHO ARE WE?</div><h2 class="display lg">MORE THAN<br/>A CREW.</h2></div>
    <div class="about-copy"><span class="sticker">SINCE '21 ✦</span><p class="lead">Gempala adalah ruang bagi pemuda untuk bertemu, bergerak, berkarya, dan tetap dekat dengan masyarakat.</p><p class="copy">Website ini menjadi arsip digital perjalanan Gempala: siapa yang ada di baliknya, kegiatan yang dijalankan, cerita yang lahir, sampai identitas member yang bisa diverifikasi lewat QR.</p><a href="/organization" class="text-link">MEET THE CREW <span>↗</span></a></div>
  </section>

  <section class="section activity-section">
    <div class="shell"><div class="section-head"><div><div class="section-kicker eyebrow">02 / WHAT WE DO</div><h2 class="display lg">RECENT<br/>MOVES.</h2></div><a class="brutal-button" href="/activities">Semua kegiatan ↗</a></div>
      <div class="activity-grid">
        {activities.map((activity, index) => <article class:list={['activity-card','card', activity.orientation, index === 0 && 'featured']}>
          <figure class="activity-media">
            <img src={activity.image} alt={activity.imageAlt} loading={index === 0 ? 'eager' : 'lazy'} width={activity.orientation === 'portrait' ? '864' : '1536'} height={activity.orientation === 'portrait' ? '1536' : activity.no === '023' ? '1042' : '1152'} />
            <figcaption>ACTIVITY / {activity.no}</figcaption>
          </figure>
          <a class="activity-body" href={`/activities#activity-${activity.no}`}><div><span class:list={['label',activity.accent]}>{activity.category}</span><p class="eyebrow activity-date">{activity.date} / {activity.location}</p></div><h3>{activity.title}</h3><span class="arrow" aria-hidden="true">↗</span></a>
        </article>)}
      </div>
    </div>
  </section>

  <section class="section shell member-callout">
    <div class="member-copy"><div class="section-kicker eyebrow">03 / THE PEOPLE</div><h2 class="display lg">WHO'S<br/>BEHIND IT?</h2><p class="lead">Bukan logo. Bukan nama organisasi. Gempala adalah orang-orang di dalamnya.</p><a class="brutal-button" href="/members">Kenalan dengan member ↗</a></div>
    <div class="member-stack">
      {featuredMembers.map((member,index) => <a class="mini-member card" href={`/m/${member.code}`} style={`--r:${index===0?-3:index===1?2:-1}deg;--x:${index*16}px`}>
        <div class:list={['mini-portrait', `tone-${getMemberTone(index)}`]}><img src={getMemberPhotoUrl(member)} alt={`Foto ${member.name}`} loading="lazy" width="1050" height="1400" /></div>
        <div><span class="eyebrow">{member.code}</span><strong>{member.nickname}</strong><small>{member.role}</small></div><span>↗</span>
      </a>)}
      <div class="verified-stamp">VERIFIED<br/>MEMBERS ✓</div>
    </div>
  </section>

  <section class="section archive-section"><div class="shell"><div class="section-kicker eyebrow">04 / MILESTONES</div><h2 class="display md">ARCHIVE OF WINS.</h2><div class="archive-layout"><figure class="archive-photo card"><img src={achievementPhoto.src} alt={achievementPhoto.alt} loading="lazy" width="1536" height="1152"/><figcaption>ACHIEVEMENT / GEMPALA ARCHIVE</figcaption></figure><div class="archive-list">{achievements.map(item => <a class="archive-row" href="/achievements"><b>{item.year}</b><div><strong>{item.title}</strong><p>{item.note}</p></div><span class="arrow">↗</span></a>)}</div></div></div></section>

  <section class="section shell"><div class="section-head"><div><div class="section-kicker eyebrow">05 / JOURNAL</div><h2 class="display md">STORIES FROM<br/>GEMPALA.</h2></div><a href="/news" class="text-link">SEMUA CERITA ↗</a></div><div class="story-grid">{stories.map((story,index)=><article class:list={['story-card', index===1&&'purple-story']}><div><span class="eyebrow">{story.date}</span><span class="label">{story.tag}</span></div><h3>{story.title}</h3><a href="/news">LIHAT JURNAL ↗</a></article>)}</div></section>

  <style>
    .hero {
      display: grid;
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
      align-items: start;
      gap: 40px;
      padding: 32px 0 64px;
    }
    .hero-copy {
      position: relative;
      z-index: 3;
      min-width: 0;
    }
    .hero-meta,
    .hero-bottom,
    .section-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
    }
    .hero-meta {
      justify-content: flex-start;
      flex-wrap: wrap;
      gap: 12px 18px;
      margin-bottom: 24px;
    }
    .hero h1 {
      font-size: clamp(76px, 9.7vw, 126px);
      line-height: 0.91;
    }
    .hero h1 span {
      color: var(--pink);
      -webkit-text-stroke: 2px var(--ink);
      text-shadow: 4px 4px 0 var(--ink);
    }
    .hero-bottom {
      align-items: flex-start;
      flex-direction: column;
      gap: 24px;
      margin-top: 32px;
    }
    .hero-bottom .lead {
      margin: 0;
      max-width: 440px;
    }

    .hero-collage {
      height: clamp(430px, 39vw, 540px);
      position: relative;
      isolation: isolate;
    }
    .hero-collage::before {
      content: "";
      position: absolute;
      inset: 16px 12px 24px;
      border: 2px dashed var(--ink);
      border-radius: 50%;
      opacity: 0.16;
      transform: rotate(-18deg);
    }
    .photo {
      position: absolute;
      margin: 0;
      border: var(--line);
      box-shadow: var(--shadow);
      border-radius: var(--radius);
      background: var(--paper);
      padding: 8px;
      transition:
        transform 0.2s ease,
        box-shadow 0.2s ease;
    }
    .photo img {
      width: 100%;
      height: auto;
      border: 2px solid var(--ink);
      background: var(--ink);
    }
    .photo figcaption {
      position: absolute;
      background: var(--paper);
      border: var(--line);
      padding: 7px 9px;
      font:
        900 9px Archivo,
        sans-serif;
      letter-spacing: 0.06em;
      box-shadow: 3px 3px var(--ink);
    }
    .photo-a {
      width: 82%;
      left: 0;
      top: 38px;
      transform: rotate(-5deg);
    }
    .photo-a figcaption {
      left: 14px;
      bottom: -16px;
    }
    .photo-b {
      width: 48%;
      right: 6px;
      bottom: 14px;
      transform: rotate(5deg);
      z-index: 2;
    }
    .photo-b figcaption {
      right: 8px;
      bottom: 12px;
      font-size: 8px;
    }
    .photo-note {
      position: absolute;
      right: 0;
      top: 4px;
      z-index: 4;
      background: var(--lime);
      border: var(--line);
      box-shadow: 4px 4px var(--ink);
      padding: 11px;
      font:
        800 9px/1.5 Archivo,
        sans-serif;
      transform: rotate(5deg);
      animation: note-in 0.5s ease-out both;
    }
    .hero-spark {
      position: absolute;
      left: 9%;
      bottom: 14%;
      width: 76px;
      height: 76px;
      fill: var(--orange);
      stroke: var(--ink);
      stroke-width: 2;
      transform: rotate(-12deg);
    }
    @keyframes note-in {
      from {
        opacity: 0;
        transform: translateY(12px) rotate(-5deg);
      }
    }
    @media (hover: hover) and (pointer: fine) {
      .photo:hover {
        transform: rotate(0deg) translateY(-5px);
        box-shadow: 7px 8px var(--ink);
      }
      .activity-card:has(a:hover) {
        transform: translateY(-4px);
        box-shadow: 7px 9px var(--ink);
      }
      .mini-member:hover {
        transform: translateX(var(--x)) rotate(0deg) translateY(-6px);
      }
      .story-card:has(a:hover) h3 {
        transform: translateX(4px);
      }
    }

    .about-grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 60px;
    }
    .about-copy {
      padding-top: 12px;
    }
    .about-copy .lead {
      margin-top: 30px;
    }
    .text-link {
      display: inline-flex;
      align-items: center;
      gap: 24px;
      border-bottom: 2px solid var(--ink);
      padding: 12px 0;
      min-height: 44px;
      font:
        800 12px Archivo,
        sans-serif;
      margin-top: 16px;
    }
    .text-link span {
      transition: transform 0.18s ease;
    }
    .text-link:hover span {
      transform: translate(3px, -3px);
    }

    .activity-section {
      background: var(--purple);
      border-block: var(--line);
    }
    .activity-grid {
      display: grid;
      grid-template-columns: minmax(0, 0.82fr) minmax(0, 1.18fr);
      grid-template-areas: "hut meg" "hut social";
      gap: 25px;
      align-items: start;
      margin-top: 44px;
    }
    .activity-card {
      transition:
        transform 0.18s ease,
        box-shadow 0.18s ease;
    }
    .activity-card:nth-child(1) {
      grid-area: hut;
    }
    .activity-card:nth-child(2) {
      grid-area: meg;
      margin-top: 40px;
    }
    .activity-card:nth-child(3) {
      grid-area: social;
    }
    .activity-media {
      margin: 0;
      border-bottom: var(--line);
      position: relative;
      background: var(--ink);
      overflow: hidden;
    }
    .activity-media img {
      width: 100%;
      height: auto;
    }
    .activity-media figcaption {
      position: absolute;
      left: 14px;
      bottom: 14px;
      background: var(--paper);
      border: var(--line);
      padding: 7px 9px;
      font:
        900 9px Archivo,
        sans-serif;
      box-shadow: 3px 3px var(--ink);
      transform: rotate(-2deg);
    }
    .activity-body {
      padding: 20px;
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 10px;
    }
    .activity-body h3 {
      font:
        900 clamp(25px, 3vw, 44px)/1.05 Archivo,
        sans-serif;
      letter-spacing: -0.04em;
      margin: 10px 0 0;
      grid-column: 1;
    }
    .activity-body .arrow {
      align-self: end;
    }
    .activity-body:focus-visible {
      outline-offset: -5px;
    }
    .activity-date {
      margin: 12px 0 0;
      line-height: 1.5;
    }

    .member-callout {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: center;
      gap: 60px;
    }
    .member-copy .lead {
      margin: 28px 0;
    }
    .member-stack {
      min-height: 400px;
      position: relative;
      padding-top: 22px;
    }
    .mini-member {
      position: relative;
      width: min(440px, 90%);
      margin: 0 auto -10px;
      padding: 12px 16px 12px 12px;
      display: grid;
      grid-template-columns: 78px minmax(0, 1fr) auto;
      align-items: center;
      gap: 16px;
      transform: translateX(var(--x)) rotate(var(--r));
      transition: transform 0.2s ease;
    }
    .mini-member strong,
    .mini-member small {
      display: block;
    }
    .mini-member strong {
      font:
        900 22px Archivo,
        sans-serif;
      margin: 4px 0;
      overflow-wrap: anywhere;
    }
    .mini-member small {
      font-size: 12px;
      line-height: 1.4;
    }
    .mini-portrait {
      width: 78px;
      height: 88px;
      border: var(--line);
      position: relative;
      overflow: hidden;
    }
    .mini-portrait img {
      width: 100%;
      height: 100%;
      object-fit: contain;
      object-position: center bottom;
    }
    .tone-purple {
      background: var(--purple);
    }
    .tone-sky {
      background: var(--blue);
    }
    .tone-lime {
      background: var(--lime);
    }
    .tone-orange {
      background: var(--orange);
    }
    .tone-pink {
      background: var(--pink);
    }
    .tone-cream {
      background: var(--paper);
    }
    .verified-stamp {
      position: absolute;
      right: 4px;
      bottom: 0;
      width: 96px;
      height: 96px;
      border: 3px solid var(--ink);
      border-radius: 50%;
      background: var(--lime);
      display: grid;
      place-items: center;
      text-align: center;
      font:
        900 10px/1.2 Archivo,
        sans-serif;
      transform: rotate(-12deg);
    }

    .archive-section {
      background: var(--blue);
      border-block: var(--line);
    }
    .archive-layout {
      display: grid;
      grid-template-columns: minmax(0, 0.78fr) minmax(0, 1.22fr);
      gap: 42px;
      align-items: start;
      margin-top: 40px;
    }
    .archive-photo {
      margin: 0;
      background: var(--paper);
      padding: 9px;
      transform: rotate(-2deg);
      position: sticky;
      top: 32px;
    }
    .archive-photo img {
      width: 100%;
      height: auto;
      border: 2px solid var(--ink);
    }
    .archive-photo figcaption {
      font:
        900 9px Archivo,
        sans-serif;
      letter-spacing: 0.08em;
      padding: 12px 5px 4px;
    }
    .archive-list {
      margin: 0;
      min-width: 0;
    }
    .archive-row b {
      font:
        900 18px Archivo,
        sans-serif;
    }
    .archive-row strong {
      display: block;
      line-height: 1.05;
    }

    .story-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      border: var(--line);
      margin-top: 40px;
      box-shadow: var(--shadow);
    }
    .story-card {
      min-height: 340px;
      padding: 24px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      border-right: var(--line);
      background: var(--white);
    }
    .story-card:last-child {
      border-right: 0;
    }
    .story-card.purple-story {
      background: var(--pink);
    }
    .story-card > div {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      justify-content: space-between;
      align-items: center;
    }
    .story-card h3 {
      font:
        800 clamp(25px, 2.6vw, 36px)/1.12 Archivo,
        sans-serif;
      letter-spacing: -0.035em;
      transition: transform 0.18s ease;
    }
    .story-card a {
      font:
        800 12px Archivo,
        sans-serif;
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      align-self: flex-start;
    }

    @media (min-width: 901px) and (max-width: 1100px) {
      .about-grid,
      .member-callout {
        gap: 32px;
      }
      .about-grid .display,
      .member-copy .display {
        font-size: 8vw;
      }
      .mini-member {
        gap: 10px;
        transform: translateX(calc(var(--x) * 0.4)) rotate(var(--r));
      }
    }
    @media (max-width: 900px) {
      .hero {
        grid-template-columns: 1fr;
        padding: 24px 0 52px;
        gap: 36px;
      }
      .hero h1 {
        font-size: clamp(64px, 14vw, 120px);
      }
      .hero-bottom {
        max-width: 660px;
        flex-direction: row;
        align-items: center;
      }
      .hero-bottom .lead {
        max-width: 390px;
      }
      .hero-bottom .brutal-button {
        flex-shrink: 0;
      }
      .hero-collage {
        height: 500px;
        max-width: 560px;
        width: calc(100% - 20px);
        margin-inline: auto;
      }
      .activity-grid {
        grid-template-columns: 1fr;
        grid-template-areas: "hut" "meg" "social";
        gap: 28px;
      }
      .activity-card:nth-child(2) {
        margin-top: 0;
      }
      .activity-card.portrait .activity-media img {
        max-height: 600px;
        object-fit: contain;
        background: var(--paper);
      }
      .archive-layout {
        grid-template-columns: 1fr;
        gap: 32px;
      }
      .archive-photo {
        position: relative;
        top: auto;
        max-width: 650px;
      }
      .about-grid,
      .member-callout {
        grid-template-columns: 1fr;
        gap: 30px;
      }
      .section-head {
        align-items: flex-start;
        flex-direction: column;
      }
      .story-grid {
        grid-template-columns: 1fr;
      }
      .story-card {
        border-right: 0;
        border-bottom: var(--line);
        min-height: 260px;
      }
      .story-card:last-child {
        border-bottom: 0;
      }
      .member-stack {
        min-height: 370px;
        max-width: 540px;
        width: 100%;
        margin-inline: auto;
      }
    }
    @media (max-width: 640px) {
      .hero {
        padding: 18px 0 44px;
        gap: 32px;
      }
      .hero-meta {
        margin-bottom: 20px;
        gap: 10px;
      }
      .hero-meta .eyebrow {
        font-size: 9px;
        letter-spacing: 0.08em;
      }
      .hero h1 {
        font-size: clamp(52px, 15.3vw, 96px);
      }
      .hero h1 span {
        -webkit-text-stroke-width: 1.5px;
        text-shadow: 3px 3px 0 var(--ink);
      }
      .hero-bottom {
        flex-direction: column;
        align-items: flex-start;
        gap: 20px;
        margin-top: 24px;
      }
      .hero-bottom .brutal-button {
        width: 100%;
      }
      .hero-collage {
        height: clamp(300px, 92vw, 450px);
      }
      .photo {
        padding: 6px;
      }
      .photo-a {
        top: 22px;
        width: 82%;
      }
      .photo-b {
        right: 2px;
        bottom: 8px;
        width: 48%;
      }
      .photo-note {
        top: 0;
        right: -2px;
        font-size: 8px;
        padding: 8px;
      }
      .photo figcaption {
        font-size: 7px;
        padding: 6px;
      }
      .photo-b figcaption {
        right: 4px;
      }
      .hero-spark {
        width: 58px;
        height: 58px;
        bottom: 15%;
      }
      .about-copy {
        padding-top: 4px;
      }
      .about-copy .lead {
        margin-top: 24px;
      }
      .activity-grid,
      .archive-layout,
      .story-grid {
        margin-top: 32px;
      }
      .activity-body {
        padding: 18px;
      }
      .activity-body h3 {
        font-size: clamp(27px, 8vw, 40px);
      }
      .member-stack {
        min-height: 326px;
        padding-top: 16px;
      }
      .mini-member {
        width: calc(100% - 20px);
        padding: 10px;
        grid-template-columns: 56px minmax(0, 1fr) auto;
        gap: 10px;
        transform: rotate(var(--r));
      }
      .mini-member strong {
        font-size: 19px;
      }
      .mini-member small {
        font-size: 10px;
      }
      .mini-portrait {
        width: 56px;
        height: 68px;
      }
      .verified-stamp {
        width: 76px;
        height: 76px;
        font-size: 8px;
        right: 4px;
      }
      .story-card {
        padding: 20px;
        min-height: 250px;
      }
      .story-card h3 {
        font-size: 27px;
      }
    }
  </style>
</BaseLayout>
