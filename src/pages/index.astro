---
import BaseLayout from '../layouts/BaseLayout.astro';
import { activities, achievements, members, stories } from '../data/site';
---
<BaseLayout title="Gempala — Youth Movement from Bojongireng">
  <section class="hero shell">
    <div class="hero-copy">
      <div class="hero-meta"><span class="label lime">EST. 2021</span><span class="eyebrow">BOJONGIRENG / CENTRAL JAVA</span></div>
      <h1 class="display xl">WE ARE<br/><span>GEMPALA.</span></h1>
      <div class="hero-bottom">
        <p class="lead">Tumbuh bareng. Bergerak bareng. Bikin sesuatu yang berarti.</p>
        <a class="brutal-button" href="/activities">Explore Gempala ↗</a>
      </div>
    </div>
    <div class="hero-collage" aria-label="Ruang untuk foto kegiatan Gempala">
      <div class="photo photo-a"><span>DROP PHOTO / 01</span></div>
      <div class="photo photo-b"><span>DROP PHOTO / 02</span></div>
      <div class="photo-note">YOUTH / SOCIAL / CREATIVE<br/>BOJONGIRENG '26</div>
    </div>
  </section>

  <div class="ticker"><div class="ticker-track"><span>GEMPALA</span><span>PEMUDA</span><span>KREATIF</span><span>SOSIAL</span><span>SOLID</span><span>BOJONGIRENG</span><span>GEMPALA</span><span>PEMUDA</span><span>KREATIF</span><span>SOSIAL</span><span>SOLID</span><span>BOJONGIRENG</span></div></div>

  <section class="section shell about-grid">
    <div><div class="section-kicker eyebrow">01 / WHO ARE WE?</div><h2 class="display lg">MORE THAN<br/>A CREW.</h2></div>
    <div class="about-copy"><span class="sticker">SINCE '21 ✦</span><p class="lead">Gempala adalah ruang bagi pemuda untuk bertemu, bergerak, berkarya, dan tetap dekat dengan masyarakat.</p><p class="copy">Website ini menjadi arsip digital perjalanan Gempala: siapa yang ada di baliknya, kegiatan yang dijalankan, cerita yang lahir, sampai identitas member yang bisa diverifikasi lewat QR.</p><a href="/organization" class="text-link">MEET THE CREW <span>↗</span></a></div>
  </section>

  <section class="section activity-section">
    <div class="shell"><div class="section-head"><div><div class="section-kicker eyebrow">02 / WHAT WE DO</div><h2 class="display lg">RECENT<br/>MOVES.</h2></div><a class="brutal-button" href="/activities">All activities ↗</a></div>
      <div class="activity-grid">
        {activities.map((activity, index) => <article class:list={['activity-card','card', index === 0 && 'featured']}>
          <div class:list={['media-placeholder',`media-${activity.accent}`]}><span>ACTIVITY / {activity.no}</span></div>
          <div class="activity-body"><div><span class:list={['label',activity.accent]}>{activity.category}</span><p class="eyebrow activity-date">{activity.date} / {activity.location}</p></div><h3>{activity.title}</h3><span class="arrow">↗</span></div>
        </article>)}
      </div>
    </div>
  </section>

  <section class="section shell member-callout">
    <div class="member-copy"><div class="section-kicker eyebrow">03 / THE PEOPLE</div><h2 class="display lg">WHO'S<br/>BEHIND IT?</h2><p class="lead">Bukan logo. Bukan nama organisasi. Gempala adalah orang-orang di dalamnya.</p><a class="brutal-button" href="/members">Open member directory ↗</a></div>
    <div class="member-stack">
      {members.slice(0,3).map((member,index) => <a class="mini-member card" href={`/m/${member.code}`} style={`--r:${index===0?-3:index===1?2:-1}deg;--x:${index*16}px`}><div class="avatar-faux">{member.nickname.slice(0,1)}</div><div><span class="eyebrow">{member.code}</span><strong>{member.nickname}</strong><small>{member.role}</small></div><span>↗</span></a>)}
      <div class="verified-stamp">VERIFIED<br/>MEMBERS ✓</div>
    </div>
  </section>

  <section class="section archive-section"><div class="shell"><div class="section-kicker eyebrow">04 / MILESTONES</div><h2 class="display md">ARCHIVE OF WINS.</h2><div class="archive-list">{achievements.map(item => <a class="archive-row" href="/achievements"><b>{item.year}</b><div><strong>{item.title}</strong><p>{item.note}</p></div><span class="arrow">↗</span></a>)}</div></div></section>

  <section class="section shell"><div class="section-head"><div><div class="section-kicker eyebrow">05 / JOURNAL</div><h2 class="display md">STORIES FROM<br/>GEMPALA.</h2></div><a href="/news" class="text-link">ALL STORIES ↗</a></div><div class="story-grid">{stories.map((story,index)=><article class:list={['story-card', index===1&&'purple-story']}><div><span class="eyebrow">{story.date}</span><span class="label">{story.tag}</span></div><h3>{story.title}</h3><a href="/news">READ STORY ↗</a></article>)}</div></section>

  <style>
    .hero{min-height:calc(100vh - 92px);padding:55px 0 75px;display:grid;grid-template-columns:1.25fr .75fr;align-items:center;gap:45px}.hero-meta,.hero-bottom,.section-head{display:flex;align-items:center;justify-content:space-between;gap:24px}.hero-meta{justify-content:flex-start;margin-bottom:24px}.hero h1 span{color:var(--purple);-webkit-text-stroke:2px var(--ink)}.hero-bottom{align-items:flex-end;margin-top:35px}.hero-bottom .lead{margin:0;max-width:430px}.hero-collage{min-height:570px;position:relative}.photo{position:absolute;border:var(--line);box-shadow:var(--shadow);border-radius:var(--radius);display:grid;place-items:center;background:var(--blue);overflow:hidden}.photo:after{content:"";position:absolute;width:130%;height:40px;background:var(--ink);opacity:.08;transform:rotate(-34deg)}.photo span{background:var(--paper);border:var(--line);padding:8px;font:800 10px Archivo;z-index:2}.photo-a{inset:20px 80px 160px 5px;transform:rotate(-4deg)}.photo-b{inset:190px 5px 20px 105px;background:var(--orange);transform:rotate(4deg)}.photo-note{position:absolute;right:5px;top:35px;background:var(--lime);border:var(--line);box-shadow:4px 4px var(--ink);padding:13px;font:800 10px/1.5 Archivo;transform:rotate(5deg)}.about-grid{display:grid;grid-template-columns:1fr 1fr;gap:70px}.about-copy{padding-top:35px}.about-copy .lead{margin-top:36px}.text-link{display:inline-flex;gap:30px;border-bottom:2px solid var(--ink);padding:10px 0;font:800 13px Archivo;margin-top:20px}.activity-section{background:var(--purple);border-block:var(--line)}.activity-grid{display:grid;grid-template-columns:1.4fr .8fr;gap:24px;margin-top:48px}.activity-card:nth-child(3){grid-column:2}.activity-card.featured{grid-row:span 2}.activity-card.featured .media-placeholder{min-height:500px}.media-lime{background:var(--lime)}.media-blue{background:var(--blue)}.media-orange{background:var(--orange)}.activity-body{padding:20px;display:grid;grid-template-columns:1fr auto;gap:10px}.activity-body h3{font:900 clamp(25px,3vw,46px)/.98 Archivo;letter-spacing:-.04em;margin:12px 0 0;grid-column:1}.activity-date{margin:12px 0 0}.member-callout{display:grid;grid-template-columns:1fr 1fr;align-items:center;gap:70px}.member-copy .lead{margin:30px 0}.member-stack{min-height:470px;position:relative;padding-top:35px}.mini-member{position:relative;width:min(430px,90%);margin:0 auto -12px;padding:18px;display:grid;grid-template-columns:66px 1fr auto;align-items:center;gap:16px;transform:translateX(var(--x)) rotate(var(--r));transition:.2s}.mini-member:hover{transform:translateX(var(--x)) rotate(0deg) translateY(-6px)}.mini-member strong,.mini-member small{display:block}.mini-member strong{font:900 22px Archivo;margin:4px 0}.mini-member small{font-size:12px}.avatar-faux{width:66px;height:66px;border:var(--line);border-radius:10px;background:var(--purple);display:grid;place-items:center;font:900 30px Archivo}.verified-stamp{position:absolute;right:0;bottom:0;width:120px;height:120px;border:3px solid var(--ink);border-radius:50%;background:var(--lime);display:grid;place-items:center;text-align:center;font:900 13px/1.2 Archivo;transform:rotate(-12deg)}.archive-section{background:var(--blue);border-block:var(--line)}.archive-list{margin-top:45px}.archive-row b{font:900 20px Archivo}.story-grid{display:grid;grid-template-columns:repeat(3,1fr);border:var(--line);margin-top:45px}.story-card{min-height:360px;padding:24px;display:flex;flex-direction:column;justify-content:space-between;border-right:var(--line);background:var(--white)}.story-card:last-child{border-right:0}.story-card.purple-story{background:var(--purple)}.story-card>div{display:flex;justify-content:space-between;align-items:center}.story-card h3{font:800 clamp(26px,3vw,40px)/1.05 Archivo;letter-spacing:-.035em}.story-card a{font:800 12px Archivo}@media(max-width:800px){.hero{min-height:auto;grid-template-columns:1fr;padding-top:35px}.hero-bottom{align-items:flex-start;flex-direction:column}.hero-collage{min-height:440px}.photo-a{inset:20px 60px 130px 5px}.photo-b{inset:160px 5px 10px 85px}.about-grid,.member-callout{grid-template-columns:1fr;gap:24px}.activity-grid{grid-template-columns:1fr}.activity-card:nth-child(3){grid-column:auto}.activity-card.featured{grid-row:auto}.activity-card.featured .media-placeholder{min-height:320px}.section-head{align-items:flex-start;flex-direction:column}.story-grid{grid-template-columns:1fr}.story-card{border-right:0;border-bottom:var(--line);min-height:280px}.story-card:last-child{border-bottom:0}.member-stack{min-height:420px}.verified-stamp{width:94px;height:94px;font-size:10px}}
  </style>
</BaseLayout>
