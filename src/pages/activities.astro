---
import BaseLayout from '../layouts/BaseLayout.astro';
import { activities } from '../data/site';
---
<BaseLayout title="Activities — Gempala"><section class="page-hero shell"><div class="section-kicker eyebrow">FIELD NOTES / ACTIVITIES</div><h1 class="display xl">WE<br/>SHOW UP.</h1><p class="lead">Kegiatan sosial, budaya, perayaan, olahraga, dan ruang kebersamaan. Yang penting bukan terlihat sibuk, tapi benar-benar hadir.</p></section><section class="section activity-board"><div class="shell"><div class="filters"><button class="label lime">ALL</button><button class="label">SOCIAL</button><button class="label">CULTURE</button><button class="label">COMMUNITY</button></div><div class="entries">{activities.map((a,index)=><article class="entry"><div class:list={['entry-photo',`tone-${a.accent}`]}><span>PHOTO ARCHIVE / {a.no}</span></div><div class="entry-info"><div><span class="eyebrow">ACTIVITY / {a.no}</span><span class="label">{a.category}</span></div><h2>{a.title}</h2><p>{a.date} — {a.location}</p><span class="arrow">↗</span></div></article>)}</div></div></section><style>.activity-board{background:var(--purple);border-top:var(--line)}.filters{display:flex;flex-wrap:wrap;gap:10px;margin-bottom:40px}.filters button{cursor:pointer}.entries{display:grid;gap:35px}.entry{display:grid;grid-template-columns:1.25fr .75fr;border:var(--line);box-shadow:var(--shadow);background:var(--white);border-radius:var(--radius);overflow:hidden}.entry:nth-child(even){grid-template-columns:.75fr 1.25fr}.entry:nth-child(even) .entry-photo{order:2;border-right:0;border-left:var(--line)}.entry-photo{min-height:430px;border-right:var(--line);display:grid;place-items:center;background:var(--lime)}.tone-blue{background:var(--blue)}.tone-orange{background:var(--orange)}.entry-photo span{border:var(--line);background:var(--paper);padding:8px;font:800 10px Archivo;transform:rotate(-3deg)}.entry-info{padding:28px;display:flex;flex-direction:column}.entry-info>div{display:flex;justify-content:space-between}.entry-info h2{font:900 clamp(40px,5vw,70px)/.92 Archivo;letter-spacing:-.055em;margin:auto 0 12px}.entry-info p{font-size:12px;font-weight:700}.entry-info .arrow{align-self:flex-end;margin-top:auto}@media(max-width:800px){.entry,.entry:nth-child(even){grid-template-columns:1fr}.entry:nth-child(even) .entry-photo{order:0;border-left:0}.entry-photo{min-height:300px;border-right:0;border-bottom:var(--line)}.entry-info{min-height:300px}}</style></BaseLayout>
